# Local dev defaults for Base44 preview. Real external-service secrets
# (Cloudinary, PayPal, Firebase, Google OAuth, etc.) are delivered by the
# platform via /run/base44/app.env and override these placeholders.

# ── Database (local Postgres compose service) ──
DATABASE_URL=postgresql://valentine:valentine@db:5432/valentine?schema=public

# ── Auth (internal secret — not an external service) ──
BETTER_AUTH_SECRET=base44-dev-secret-9f3a7c1e5b8d2a4f6e9c0b3d7a1f5e8c
BETTER_AUTH_URL=http://localhost:3000

# ── Economy defaults ──
DIAMONDS_PER_USD=200
DAILY_LOGIN_BONUS_COINS=10
AD_REWARD_COINS=5
AD_REWARD_COOLDOWN_MINUTES=2
AD_REWARD_DAILY_CAP=12
CASHOUT_MIN_DIAMONDS=3000
PLATFORM_FEE_RATE=0.30

# ── Admin ──
ADMIN_EMAILS=admin@example.com

# ── Payment provider defaults (stub) ──
PAYMENTS_BUY_PROVIDER=paypal
PAYMENTS_WITHDRAW_PROVIDER=paypal
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

# ── Realtime WS (not run locally in preview) ──
NEXT_PUBLIC_WS_URL=

# ── LiveKit (live video/audio — token route returns 503 until set) ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
