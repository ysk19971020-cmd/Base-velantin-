# ================================================
# Valentine Express Live Stream — .env.example
# Copy to .env and fill in real values.
# NEVER commit this file.
# ================================================

# ── Database ──
DATABASE_URL=file:./db/custom.db
# Production: DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/valentine_express

# ── Auth ──
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (KYC / avatar / media) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payment Providers ──
PAYMENTS_BUY_PROVIDER=paypal
PAYMENTS_WITHDRAW_PROVIDER=paypal

# ── PayPal ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=

# ── Dialog Genie (LATER — stub only) ──
DIALOG_GENIE_API_KEY=
DIALOG_GENIE_API_SECRET=
DIALOG_GENIE_MERCHANT_ID=
DIALOG_GENIE_BASE_URL=
DIALOG_GENIE_WEBHOOK_SECRET=

# ── Economy ──
DIAMONDS_PER_USD=200

# ── Free coins (daily bonus + rewarded ad) ──
DAILY_LOGIN_BONUS_COINS=10
AD_REWARD_COINS=5
AD_REWARD_COOLDOWN_MINUTES=2
AD_REWARD_DAILY_CAP=12
# HilltopAds Video VAST tag URL for the "Watch ad for coins" button — get
# this from your HilltopAds publisher dashboard (Video VAST ad format).
# It's a full URL (something like https://hilltopads.com/vast?zone=XXXXX,
# check your dashboard for the exact one), not just a zone id.
# Leave blank in dev — the button will show "Ad not configured yet" instead
# of granting coins with no ad shown.
NEXT_PUBLIC_HILLTOP_VAST_URL=
CASHOUT_MIN_DIAMONDS=3000
PLATFORM_FEE_RATE=0.30

# ── Admin ──
ADMIN_EMAILS=admin@example.com

# ── Agora (video, chat, gifts, presence — everything realtime) ──
# Create a free project at https://console.agora.io (copy the App ID, enable
# App Certificate under project settings). Enable "Signaling" for the project
# for chat/presence. Set both values on Vercel as environment variables.
# Live video/audio + chat all flow through Agora's cloud — no separate WS
# service needed anymore (mini-services/* are obsolete now).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# ── Firebase Web Push Notifications ──
# All NEXT_PUBLIC_ — these are client-exposed by design (Firebase web
# config is not a secret; access control is enforced by Firebase Security
# Rules / your own backend, not by hiding these values).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Get the VAPID key from Firebase Console → Project Settings → Cloud
# Messaging → Web Push certificates.
#
# IMPORTANT: public/firebase-messaging-sw.js cannot read process.env (it's
# a static file, not processed by Next.js) — its copy of these same values
# must be edited directly in that file if you change Firebase projects.

# ── WebRTC TURN (optional) ──
TURN_URL=
TURN_USER=
TURN_PASS=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=
